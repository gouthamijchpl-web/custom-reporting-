# Local application mode
SPRING_PROFILES_ACTIVE=dev

# Database
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/customreporting
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=0

# Backend
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.10.56:5173
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
APP_CREDENTIAL_ENCRYPTION_KEY=local-credential-key-change-before-production
APP_JWT_SECRET=local-development-only-secret-change-me-please
APP_REFRESH_COOKIE_SECURE=false
APP_DETAILED_AUTHENTICATION_ERRORS=true
APP_LOG_LEVEL=DEBUG
HIBERNATE_SQL_LOG_LEVEL=INFO

# Frontend
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
