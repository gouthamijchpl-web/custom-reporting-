# Base path the frontend uses for API calls.
# Left as a relative path so the Vite dev proxy and a same-origin deployment both work.
VITE_API_BASE_URL=/api/v1

# Backend the Vite dev server proxies to. Development only.
VITE_API_PROXY_TARGET=http://localhost:8080

# Regional Zoho Accounts endpoint suggested when connecting a Zoho Books source.
# The backend still validates the submitted HTTPS Zoho domain before token exchange.
VITE_ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
